---
interface Props {
  title: string;
  description?: string;
  structuredData?: object;
  bodyClass?: string;
  topPage?: boolean;
}

const {
  title,
  description = "Service de demande d'ETA pour le Royaume-Uni en français. Obtenez votre autorisation de voyage électronique facilement.",
  structuredData,
  bodyClass = '',
  topPage = false,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
import '../styles/global.css';
---

<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="format-detection" content="telephone=no" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="alternate" hreflang="fr" href={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="fr_FR" />
  <link rel="icon" href="/favicon.ico" />
  <link rel="stylesheet" href="/assets/css/style.css" />
  {topPage && <link rel="stylesheet" href="/assets/css/top.css" />}
  <link rel="stylesheet" href="/assets/css/site-legacy.css" />
  {structuredData && (
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  )}
</head>
<body class={bodyClass}>
  <header>
    <div class="header-description">
      <h1>Faire la demande d’ETA：UK ETA application site</h1>
    </div>
    <div class="header-wrapper">
      <div class="header-logo">
        <a href="/">
          <picture>
            <source media="(max-width: 767px)" srcset="/assets/images/logo/logo-text-sp.svg" />
            <img src="/assets/images/logo/logo-text.svg" alt="UK ETA Application Site" />
          </picture>
        </a>
      </div>
      <div class="pc-only header-btn">
        <a href="/entry/" class="btn btn-apply btn-right-arrow">
          <img class="icon-entry" src="/assets/images/icon/icon-entry.webp" alt="" width="36" height="36" />
          <span class="btn-text">
            <span class="btn-main">Demander l'ETA</span>
            <span class="btn-sub">Au moins 72h avant le départ</span>
          </span>
        </a>
      </div>
      <button id="uketa-sp-menu-btn" type="button" class="menu sp-only" aria-controls="global-nav-sp" aria-expanded="false">
        <i class="icon icon-menu"></i>
        <span>Menu</span>
      </button>
    </div>
  </header>

  <nav class="global-nav pc-only" aria-label="Navigation principale">
    <ul class="global-nav-main">
      <li><a href="/">ETA Royaume-Uni</a></li>
      <li><a href="/entry/">Demander l'ETA</a></li>
      <li><a href="/status/">Vérifier la demande</a></li>
      <li><a href="/contact/">Contact</a></li>
      <li><a href="/eta/faq/">FAQ</a></li>
    </ul>
  </nav>

  <nav id="global-nav-sp" class="global-nav sp-only" aria-label="Navigation mobile" aria-hidden="true">
    <ul>
      <li><a href="/"><p>ETA Royaume-Uni</p><i class="icon icon-rightarrow"></i></a></li>
      <li><a href="/entry/"><p>Demander l'ETA</p><i class="icon icon-rightarrow"></i></a></li>
      <li><a href="/status/"><p>Vérifier la demande</p><i class="icon icon-rightarrow"></i></a></li>
      <li><a href="/contact/"><p>Contact</p><i class="icon icon-rightarrow"></i></a></li>
      <li><a href="/eta/faq/"><p>FAQ</p><i class="icon icon-rightarrow"></i></a></li>
      <li><a href="/service/"><p>À propos de l'ETA</p><i class="icon icon-rightarrow"></i></a></li>
      <li><a href="/fee/"><p>Frais ETA Royaume-Uni</p><i class="icon icon-rightarrow"></i></a></li>
    </ul>
  </nav>

  <main>
    <slot />
  </main>

  <footer>
    <div id="floating-off" class="common-nav">
      <section>
        <p><a href="/page_cat/uketa/">Infos ETA Royaume-Uni</a><i class="icon icon-hyphen"></i></p>
        <div class="list-wrap" style="display:block;">
          <ul>
            <li><a href="/">ETA Royaume-Uni — Accueil</a></li>
            <li><a href="/service/">À propos de l'ETA</a></li>
            <li><a href="/fee/">Frais ETA Royaume-Uni</a></li>
            <li><a href="/eta/">Guide ETA</a></li>
          </ul>
        </div>
      </section>
      <section>
        <p><a href="/page_cat/site/">Infos du site</a><i class="icon icon-hyphen"></i></p>
        <div class="list-wrap" style="display:block;">
          <ul>
            <li><a href="/entry/">Demander l'ETA</a></li>
            <li><a href="/status/">Vérifier la demande</a></li>
            <li><a href="/contact/">Contact</a></li>
            <li><a href="/privacy/">Politique de confidentialité</a></li>
            <li><a href="/mentions-legales/">Mentions légales</a></li>
            <li><a href="/agreement/">Conditions générales</a></li>
          </ul>
        </div>
      </section>
    </div>
    <div class="footer-bottom">
      <small class="footer-bottom-text">©2026 Site de demande d'ETA pour le Royaume-Uni. Tous droits réservés.</small>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const button = document.getElementById('uketa-sp-menu-btn');
      const menu = document.getElementById('global-nav-sp');
      if (!button || !menu) return;
      button.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!open));
        menu.setAttribute('aria-hidden', String(open));
        menu.style.display = open ? 'none' : 'block';
        const icon = button.querySelector('.icon');
        icon?.classList.toggle('icon-menu', open);
        icon?.classList.toggle('icon-close', !open);
      });
    })();
  </script>
</body>
</html>
