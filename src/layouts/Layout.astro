---
interface Props {
  title: string;
  description?: string;
  structuredData?: object;
  bodyClass?: string;
  topPage?: boolean;
  headerDescription?: string;
  legacyHeaderHtml?: string;
  legacyDesktopNavHtml?: string;
  legacyMobileNavHtml?: string;
  legacyMainHtml?: string;
  legacyFooterFixedHtml?: string;
}

const {
  title,
  description = "Service de demande d'ETA pour le Royaume-Uni en français. Obtenez votre autorisation de voyage électronique facilement.",
  structuredData,
  bodyClass = '',
  topPage = false,
  headerDescription = 'Faire la demande d’ETA：UK ETA application site',
  legacyHeaderHtml,
  legacyDesktopNavHtml,
  legacyMobileNavHtml,
  legacyMainHtml,
  legacyFooterFixedHtml,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
import SiteFooter from '../components/SiteFooter.astro';
import { siteNavigationSections } from '../content/site-navigation';
import '../styles/global.css';
---

<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="format-detection" content="telephone=no" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="alternate" hreflang="fr" href={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="fr_FR" />
  <link rel="icon" href="/favicon.ico" />
  <link rel="stylesheet" href="/assets/css/style.css" />
  <link rel="stylesheet" href="/assets/css/top.css" />
  {!topPage && <link rel="stylesheet" href="/assets/css/page.css" />}
  <link rel="stylesheet" href="/assets/css/site-legacy.css" />
  <script id="uketa-ga4-consent-default" is:inline>
    (() => {
      const consentKey = 'uketa_analytics_consent_v1';
      const measurementId = 'G-Y2MEYTFRV8';
      let storedChoice = null;

      try {
        storedChoice = window.localStorage.getItem(consentKey);
      } catch (error) {
        storedChoice = null;
      }

      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () {
        window.dataLayer.push(arguments);
      };

      const analyticsGranted = storedChoice === 'granted';
      let tagRequested = false;

      function loadGoogleTag() {
        if (tagRequested) return;
        tagRequested = true;

        const script = document.createElement('script');
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(measurementId)}`;
        document.head.appendChild(script);

        window.gtag('js', new Date());
        window.gtag('config', measurementId, {
          allow_google_signals: false,
          allow_ad_personalization_signals: false,
        });
      }

      window.gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: analyticsGranted ? 'granted' : 'denied',
        wait_for_update: 500,
      });
      window.gtag('set', 'ads_data_redaction', true);

      window.uketaAnalyticsConsent = {
        choice: storedChoice,
        load: loadGoogleTag,
        update(choice) {
          const granted = choice === 'granted';
          window.gtag('consent', 'update', {
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
            analytics_storage: granted ? 'granted' : 'denied',
          });

          this.choice = granted ? 'granted' : 'denied';
          try {
            window.localStorage.setItem(consentKey, this.choice);
          } catch (error) {
            // Keep the choice for the current page when storage is unavailable.
          }
          if (granted) loadGoogleTag();
        },
      };

      if (analyticsGranted) loadGoogleTag();
    })();
  </script>
  {structuredData && (
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  )}
</head>
<body class={bodyClass}>
  {legacyHeaderHtml ? <Fragment set:html={legacyHeaderHtml} /> : <header>
    <div class="header-description">
      <h1>{headerDescription}</h1>
    </div>
    <div class="header-wrapper">
      <div class="header-logo">
        <a href="/">
          <picture>
            <source media="(max-width: 767px)" srcset="/assets/images/logo/logo-text-sp.svg" />
            <img src="/assets/images/logo/logo-text.svg" alt="UK ETA Application Site" />
          </picture>
        </a>
      </div>
      <div class="pc-only header-btn">
        <a href="/entry/" class="btn btn-apply btn-right-arrow">
          <img class="icon-entry" src="/assets/images/icon/icon-entry.webp" alt="" width="36" height="36" />
          <span class="btn-text">
            <span class="btn-main">Demander l'ETA</span>
            <span class="btn-sub">Au moins 72h avant le départ</span>
          </span>
        </a>
      </div>
      <button id="uketa-sp-menu-btn" type="button" class="menu sp-only" aria-controls="global-nav-sp" aria-expanded="false">
        <i class="icon icon-menu"></i>
        <span>Menu</span>
      </button>
    </div>
  </header>}

  {legacyDesktopNavHtml ? <Fragment set:html={legacyDesktopNavHtml} /> : <nav class="global-nav pc-only" aria-label="Navigation principale">
    <ul class="global-nav-main">
      <li><a href="/">ETA Royaume-Uni</a></li>
      <li><a href="/entry/">Demander l'ETA</a></li>
      <li><a href="/status/">Vérifier la demande</a></li>
      <li><a href="/contact/">Contact</a></li>
      <li class="global-nav-more">
        <a href="/eta/faq/">FAQ <i class="icon icon-bottomarrow" aria-hidden="true"></i></a>
      </li>
    </ul>
    <div class="global-nav-expand">
      <div class="common-nav">
        {siteNavigationSections.map((section) => (
          <section class="pc-only">
            <h2><a href={section.href}>{section.title}</a></h2>
            <ul class="four-rows">
              {section.links.map((link) => (
                <li><a href={link.href}>{link.label}<i class="icon icon-rightarrow" aria-hidden="true"></i></a></li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </nav>}

  {legacyMobileNavHtml ? <Fragment set:html={legacyMobileNavHtml} /> : <nav id="global-nav-sp" class="global-nav sp-only" aria-label="Navigation mobile" aria-hidden="true">
    <ul>
      <li><a href="/"><p>ETA Royaume-Uni</p><i class="icon icon-rightarrow"></i></a></li>
      <li><a href="/entry/"><p>Demander l'ETA</p><i class="icon icon-rightarrow"></i></a></li>
      <li><a href="/status/"><p>Vérifier la demande</p><i class="icon icon-rightarrow"></i></a></li>
      <li><a href="/contact/"><p>Contact</p><i class="icon icon-rightarrow"></i></a></li>
      <li><a href="/eta/faq/"><p>FAQ</p><i class="icon icon-rightarrow"></i></a></li>
      <li><a href="/service/"><p>À propos de l'ETA</p><i class="icon icon-rightarrow"></i></a></li>
      <li><a href="/fee/"><p>Frais ETA Royaume-Uni</p><i class="icon icon-rightarrow"></i></a></li>
    </ul>
  </nav>}

  {legacyMainHtml
    ? <Fragment set:html={legacyMainHtml} />
    : <main><slot /></main>
  }

  <SiteFooter />

  {legacyFooterFixedHtml && <Fragment set:html={legacyFooterFixedHtml} />}

  <section
    id="uketa-cookie-consent"
    role="dialog"
    aria-label="Préférences relatives aux cookies"
    aria-live="polite"
    hidden
  >
    <p>
      Nous utilisons Google Analytics pour mesurer l’audience et améliorer ce site.
      Vous pouvez accepter ou refuser les cookies analytiques.
      {' '}<a href="/privacy/">En savoir plus</a>
    </p>
    <div class="uketa-cookie-actions">
      <button id="uketa-cookie-reject" class="uketa-cookie-button" type="button">Tout refuser</button>
      <button id="uketa-cookie-accept" class="uketa-cookie-button" type="button">Accepter les cookies analytiques</button>
    </div>
  </section>

  <button id="uketa-cookie-manage" type="button" hidden>Gérer les cookies</button>

  <script is:inline>
    (() => {
      const button = document.querySelector('#uketa-sp-menu-btn, #sp-menu-btn');
      const menu = document.getElementById('global-nav-sp');
      if (!button || !menu) return;
      button.addEventListener('click', (event) => {
        event.preventDefault();
        const open = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!open));
        menu.setAttribute('aria-hidden', String(open));
        menu.style.display = open ? 'none' : 'block';
        const icon = button.querySelector('.icon');
        icon?.classList.toggle('icon-menu', open);
        icon?.classList.toggle('icon-close', !open);
      });

      const desktopNav = document.querySelector('.global-nav.pc-only');
      const desktopMore = desktopNav?.querySelector('.global-nav-more');
      const desktopExpand = desktopNav?.querySelector('.global-nav-expand');
      let desktopNavCloseTimer;

      const setDesktopNavOpen = (open) => {
        if (!(desktopExpand instanceof HTMLElement) || !(desktopMore instanceof HTMLElement)) return;
        window.clearTimeout(desktopNavCloseTimer);
        desktopExpand.style.display = open ? 'block' : 'none';
        desktopMore.classList.toggle('is-open', open);
      };

      const scheduleDesktopNavClose = () => {
        window.clearTimeout(desktopNavCloseTimer);
        desktopNavCloseTimer = window.setTimeout(() => setDesktopNavOpen(false), 140);
      };

      for (const element of [desktopMore, desktopExpand]) {
        element?.addEventListener('mouseenter', () => setDesktopNavOpen(true));
        element?.addEventListener('mouseleave', scheduleDesktopNavClose);
      }
      desktopMore?.addEventListener('focusin', () => setDesktopNavOpen(true));
      desktopExpand?.addEventListener('focusin', () => setDesktopNavOpen(true));
      desktopNav?.addEventListener('focusout', (event) => {
        const nextTarget = event.relatedTarget;
        if (!(nextTarget instanceof Node) || !desktopNav.contains(nextTarget)) scheduleDesktopNavClose();
      });

      const mobileMore = menu.querySelector('.global-nav-more');
      const mobileCommonNav = menu.querySelector('.common-nav');
      mobileMore?.addEventListener('click', (event) => {
        event.preventDefault();
        if (!mobileCommonNav) return;
        mobileCommonNav.style.display = getComputedStyle(mobileCommonNav).display === 'none' ? 'block' : 'none';
      });

      for (const icon of menu.querySelectorAll('.common-nav h2 i')) {
        icon.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          const list = icon.closest('h2')?.nextElementSibling;
          if (list instanceof HTMLElement) {
            list.style.display = getComputedStyle(list).display === 'none' ? 'block' : 'none';
          }
        });
      }

      const footerMedia = window.matchMedia('(max-width: 768px)');
      const footerToggles = document.querySelectorAll('.site-footer-toggle');

      function setFooterSection(button, open) {
        const listId = button.getAttribute('aria-controls');
        const list = listId ? document.getElementById(listId) : null;
        if (!(list instanceof HTMLElement)) return;

        button.setAttribute('aria-expanded', String(open));
        list.setAttribute('aria-hidden', String(!open));
        list.style.display = open ? 'block' : 'none';
        const icon = button.querySelector('.icon');
        icon?.classList.toggle('icon-hyphen', open);
        icon?.classList.toggle('icon-plus', !open);
      }

      for (const button of footerToggles) {
        if (!(button instanceof HTMLButtonElement)) continue;
        setFooterSection(button, !footerMedia.matches);
        button.addEventListener('click', (event) => {
          event.preventDefault();
          setFooterSection(button, button.getAttribute('aria-expanded') !== 'true');
        });
      }

      footerMedia.addEventListener('change', () => {
        for (const button of footerToggles) {
          if (button instanceof HTMLButtonElement) setFooterSection(button, !footerMedia.matches);
        }
      });
    })();
  </script>
  <script id="uketa-ga4-consent-controls" is:inline>
    (() => {
      const consent = window.uketaAnalyticsConsent;
      const banner = document.getElementById('uketa-cookie-consent');
      const manageButton = document.getElementById('uketa-cookie-manage');
      const acceptButton = document.getElementById('uketa-cookie-accept');
      const rejectButton = document.getElementById('uketa-cookie-reject');

      if (!consent || !banner || !manageButton || !acceptButton || !rejectButton) return;

      function showBanner() {
        banner.hidden = false;
        manageButton.hidden = true;
      }

      function hideBanner() {
        banner.hidden = true;
        manageButton.hidden = false;
      }

      acceptButton.addEventListener('click', () => {
        consent.update('granted');
        hideBanner();
      });
      rejectButton.addEventListener('click', () => {
        consent.update('denied');
        hideBanner();
      });
      manageButton.addEventListener('click', showBanner);

      if (consent.choice === 'granted' || consent.choice === 'denied') hideBanner();
      else showBanner();
    })();
  </script>
</body>
</html>
