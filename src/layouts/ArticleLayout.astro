---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description?: string;
  structuredData?: object;
  breadcrumbs?: { label: string; href?: string }[];
  relatedArticles?: { title: string; href: string }[];
}

const { title, description, structuredData, breadcrumbs = [], relatedArticles = [] } = Astro.props;
---

<Layout title={title} description={description} structuredData={structuredData} bodyClass="article-page">
  <div class="article-layout">
    {breadcrumbs.length > 0 && (
      <nav class="article-breadcrumbs" aria-label="Fil d'Ariane">
        <ol>
          <li><a href="/">Accueil</a></li>
          {breadcrumbs.map((crumb) => (
            <li>
              <span aria-hidden="true">›</span>
              {crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span>{crumb.label}</span>}
            </li>
          ))}
        </ol>
      </nav>
    )}

    <div class="article-columns">
      <article class="article-content">
        <h1>{title}</h1>
        <slot />
      </article>

      {relatedArticles.length > 0 && (
        <aside class="article-related" aria-label="Articles connexes">
          <div>
            <h2>Articles connexes</h2>
            <ul>
              {relatedArticles.map((a) => (
                <li><a href={a.href}>{a.title}</a></li>
              ))}
            </ul>
          </div>
        </aside>
      )}
    </div>
  </div>
</Layout>
