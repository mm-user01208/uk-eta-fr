---
import CategoryHub from '../../components/CategoryHub.astro';
const items = [
  { title: 'Différence entre ETA et visa', href: '/visa/difference-eta-visa/', label: 'Choisir', description: "Comparez les conditions selon la durée et le motif de votre séjour." },
  { title: 'Visa travailleur créatif', href: '/visa/creative-worker/', label: 'Travail créatif', description: "Conditions applicables aux artistes, musiciens, cinéastes et danseurs." },
  { title: 'Engagement rémunéré autorisé', href: '/visa/permitted-paid-engagement/', label: 'Mission ponctuelle', description: "Règles pour les spécialistes invités pour un engagement rémunéré au Royaume-Uni." },
];
---
<CategoryHub
  title="Visas pour le Royaume-Uni"
  description="Identifiez l'autorisation adaptée à votre séjour et consultez les règles applicables aux activités professionnelles ponctuelles."
  eyebrow="Visas et autorisations"
  items={items}
/>
