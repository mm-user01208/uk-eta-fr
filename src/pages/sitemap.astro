---
import Layout from '../layouts/Layout.astro';

const sections = [
  {
    title: 'ETA Royaume-Uni',
    links: [
      { href: '/service/', label: "Qu'est-ce que l'ETA ?" },
      { href: '/eta/procedure-demande/', label: 'Procédure de demande' },
      { href: '/fee/', label: 'Tarifs et paiement' },
      { href: '/eta/pays-eligibles/', label: 'Pays éligibles' },
      { href: '/eta/documents-necessaires/', label: 'Documents nécessaires' },
      { href: '/eta/validite-et-delai/', label: 'Validité et délai' },
      { href: '/eta/faq/', label: 'Questions fréquentes' },
    ],
  },
  {
    title: 'Entrée au Royaume-Uni',
    links: [
      { href: '/entree-uk/aeroport-heathrow/', label: 'Aéroport de Heathrow' },
      { href: '/entree-uk/irlande-du-nord/', label: 'Irlande du Nord' },
      { href: '/entree-uk/transit-correspondance/', label: 'Transit et correspondance' },
      { href: '/visa/difference-eta-visa/', label: 'Différence entre ETA et visa' },
    ],
  },
  {
    title: 'Informations du site',
    links: [
      { href: '/contact/', label: 'Contact' },
      { href: '/mentions-legales/', label: 'Mentions légales' },
      { href: '/agreement/', label: 'Conditions générales' },
      { href: '/privacy/', label: 'Politique de confidentialité' },
      { href: '/info/a-propos/', label: 'À propos' },
    ],
  },
];
---

<Layout title="Plan du site — UK ETA Application Site" description="Plan du site UK ETA : retrouvez toutes les pages d'information sur l'ETA et l'entrée au Royaume-Uni.">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-[#1e3a5f] mb-8">Plan du site</h1>
    <div class="grid md:grid-cols-2 gap-8">
      {sections.map((section) => (
        <section>
          <h2 class="text-xl font-bold text-[#1e3a5f] mb-3">{section.title}</h2>
          <ul class="space-y-2">
            {section.links.map((link) => (
              <li><a class="text-blue-700 hover:underline" href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</Layout>
