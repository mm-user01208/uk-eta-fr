---
import Layout from '../layouts/Layout.astro';
import { siteNavigationSections } from '../content/site-navigation';

const etaActionHrefs = new Set(['/entry/', '/status/']);
const etaActionLinks = siteNavigationSections
  .find((section) => section.id === 'site')
  ?.links.filter((link) => etaActionHrefs.has(link.href)) ?? [];

const sitemapSections = siteNavigationSections.map((section) => {
  if (section.id === 'eta') {
    return {
      ...section,
      links: [
        section.links[0],
        ...etaActionLinks,
        ...section.links.slice(1),
      ],
    };
  }

  if (section.id === 'site') {
    return {
      ...section,
      links: section.links.filter((link) => !etaActionHrefs.has(link.href)),
    };
  }

  return section;
});

const canonicalPageCount = new Set(
  sitemapSections.flatMap((section) => [section.href, ...section.links.map((link) => link.href)]),
).size;
---

<Layout
  title="Plan du site — UK ETA Application Site"
  description="Plan du site UK ETA : retrouvez toutes les pages d'information sur l'ETA, l'entrée au Royaume-Uni, les visas et notre service."
  bodyClass="sitemap-page"
>
  <div class="sitemap-shell">
    <nav class="sitemap-breadcrumbs" aria-label="Fil d'Ariane">
      <a href="/">Accueil</a><span aria-hidden="true">›</span><span>Plan du site</span>
    </nav>

    <header class="sitemap-hero">
      <p class="sitemap-eyebrow">Navigation</p>
      <h1>Plan du site</h1>
      <p>Accédez à l’ensemble des informations disponibles sur notre site.</p>
      <span>{canonicalPageCount} pages en français</span>
    </header>

    <div class="sitemap-directory">
      {sitemapSections.map((section) => (
        <section class="sitemap-section" aria-labelledby={`sitemap-${section.id}-title`}>
          <h2 id={`sitemap-${section.id}-title`}><a href={section.href}>{section.title}</a></h2>
          <ul>
            {section.links.map((link) => (
              <li><a href={link.href}><span>{link.label}</span><span aria-hidden="true">›</span></a></li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</Layout>
