---
import { siteNavigationSections } from '../content/site-navigation';
---

<footer class="site-footer">
  <nav id="floating-off" class="common-nav" aria-label="Plan du site en pied de page">
    {siteNavigationSections.map((section) => (
      <section>
        <p>
          <a href={section.href}>{section.title}</a>
          <button
            class="site-footer-toggle"
            type="button"
            aria-controls={`site-footer-${section.id}`}
            aria-expanded="true"
            aria-label={`Afficher ou masquer les pages de ${section.title}`}
          >
            <i class="icon icon-hyphen" aria-hidden="true"></i>
          </button>
        </p>
        <div id={`site-footer-${section.id}`} class="list-wrap" aria-hidden="false">
          <ul class="four-rows">
            {section.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      </section>
    ))}
  </nav>
  <div class="footer-bottom">
    <small class="footer-bottom-text">©2026 Site de demande d'ETA pour le Royaume-Uni. Tous droits réservés.</small>
  </div>
</footer>
